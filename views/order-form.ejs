<%- include('partials/header') %>

<!--
  VIEW - Order form, shared by CREATE (step 6) and EDIT.
  Rendered by OrderController.newOrder / editOrder, and re-rendered by
  create() / update() when OrderModel.validate returns errors.
  `orderId` is null for a new order and set when editing an existing one.
-->

<% const isEdit = Boolean(orderId); %>

<div class="page-head">
  <div>
    <h1><%= isEdit ? 'Edit Order #' + orderId : 'Place an Order' %></h1>
    <p class="sub">
      <% if (isEdit) { %>
        Change the ticket while it is still waiting in the queue.
      <% } else { %>
        Your drink goes straight into the bartender&rsquo;s queue.
      <% } %>
    </p>
  </div>
  <a class="btn btn-ghost" href="<%= isEdit ? '/order/' + orderId : '/menu' %>">
    &larr; <%= isEdit ? 'Back to the order' : 'Back to the menu' %>
  </a>
</div>

<% if (errors.length > 0) { %>
  <div class="alert alert-error">
    <strong>Please fix the following:</strong>
    <ul>
      <% errors.forEach(function (error) { %>
        <li><%= error %></li>
      <% }); %>
    </ul>
  </div>
<% } %>

<form class="card form" method="POST" action="<%= isEdit ? '/order/' + orderId : '/order' %>">

  <label class="field">
    <span class="label">Cocktail</span>
    <select name="cocktail_id" required>
      <option value="">&mdash; Choose a cocktail &mdash;</option>
      <% cocktails.forEach(function (cocktail) { %>
        <option value="<%= cocktail.cocktail_id %>"
          <%= String(form.cocktail_id) === String(cocktail.cocktail_id) ? 'selected' : '' %>>
          <%= cocktail.name %> &mdash; <%= formatPrice(cocktail.price) %>
        </option>
      <% }); %>
    </select>
  </label>

  <div class="field-row">
    <label class="field">
      <span class="label">Name for the order</span>
      <input type="text" name="patron_name" value="<%= form.patron_name %>"
             placeholder="e.g. Yousif" maxlength="60" required>
    </label>

    <label class="field">
      <span class="label">Table / seat</span>
      <input type="text" name="table_number" value="<%= form.table_number %>"
             placeholder="e.g. 12 or Bar 3" maxlength="20" required>
    </label>

    <label class="field field-narrow">
      <span class="label">Quantity</span>
      <input type="number" name="quantity" value="<%= form.quantity %>"
             min="1" max="6" step="1" required>
    </label>
  </div>

  <label class="field">
    <span class="label">Special instructions <em>(optional)</em></span>
    <textarea name="special_instructions" rows="3" maxlength="250"
              placeholder="Extra lime, no salt on the rim, light ice..."><%= form.special_instructions %></textarea>
  </label>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">
      <%= isEdit ? 'Save Changes' : 'Send Order to the Bar' %>
    </button>
    <% if (isEdit) { %>
      <a class="btn btn-ghost" href="/order/<%= orderId %>">Cancel</a>
    <% } %>
  </div>

</form>

<%- include('partials/footer') %>
